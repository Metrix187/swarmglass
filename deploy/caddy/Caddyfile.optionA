# Option A — swarmglass.quantara.cv as an isolated service (recommended; this is what runs on quantara-nood).
# Append these blocks to /etc/caddy/Caddyfile on the host that runs the container, replace the basic_auth hash
# (`caddy hash-password --plaintext '…'`), `caddy validate`, then `systemctl reload caddy`.
#
# No `log { output file … }` block on purpose: the app records its own telemetry, and a file output that caddy
# cannot open makes the *reload* fail while `caddy validate` still passes — which leaves a Caddyfile on disk that
# will not load on the next restart. Proxy logs go to journald like every other site on the box.

# ---- public honeypot ----
swarmglass.quantara.cv {
	encode zstd gzip

	# the app sets its own security headers; caddy only adds transport-level ones
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# never let the console be reached through the public hostname, even if someone mounts it on the public listener
	@console path /__quantara/* /login /logout /ui/* /api/overview* /api/sessions* /api/settings*
	respond @console 404

	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {client_ip}
		# keep the wire-level details the honeypot records honest
		flush_interval -1
	}
}

# ---- research console: separate hostname, edge basic_auth in front of the app's own login ----
research.swarmglass.quantara.cv {
	encode zstd gzip

	# second factor at the edge. generate with: caddy hash-password --plaintext '…'
	# TODO (hardening): wrap this in `@allowed remote_ip <your tailnet / vpn / office ranges>` once those are known,
	# with a `respond 404` for everyone else — see the commented block below.
	basic_auth {
		researcher $2a$14$REPLACE_WITH_CADDY_HASH_PASSWORD_OUTPUT
	}
	reverse_proxy 127.0.0.1:8081 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {client_ip}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# allowlisted variant:
	# @allowed remote_ip 100.64.0.0/10 10.0.0.0/8
	# handle @allowed {
	# 	basic_auth { researcher $2a$14$… }
	# 	reverse_proxy 127.0.0.1:8081 { header_up X-Forwarded-Proto {scheme}; header_up X-Real-IP {client_ip} }
	# }
	# handle { respond "not found" 404 }
}
