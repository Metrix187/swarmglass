# Swarmglass configuration. Copy to .env and fill in the TODOs.
# Every value has a sane default except the two secrets marked REQUIRED.

# ---- runtime ----
SWARMGLASS_ENV=production                 # production | development
SWARMGLASS_DATA_DIR=./data                # sqlite db, logs, exports live here
SWARMGLASS_SEED_DIR=./seed                # versioned wiki content
SWARMGLASS_CONFIG_DIR=./config            # heuristics + experiment definitions

# ---- public honeypot listener ----
SWARMGLASS_PUBLIC_HOST=0.0.0.0
SWARMGLASS_PUBLIC_PORT=8080
SWARMGLASS_PUBLIC_BASE_URL=https://swarmglass.quantara.cv
SWARMGLASS_BASE_PATH=                     # "" for a subdomain (option A), "/swarmglass" for a path mount (option B)

# ---- research console listener (never expose this port directly) ----
SWARMGLASS_CONSOLE_HOST=127.0.0.1
SWARMGLASS_CONSOLE_PORT=8081
SWARMGLASS_CONSOLE_BASE_URL=https://research.swarmglass.quantara.cv
SWARMGLASS_CONSOLE_USER=researcher
# REQUIRED in production: scrypt hash from `npm run hash-password`
SWARMGLASS_CONSOLE_PASSWORD_HASH=          # TODO
# development only, ignored in production:
SWARMGLASS_CONSOLE_PASSWORD=
# optional: comma separated CIDRs allowed to reach the console (VPN / tailnet / office)
SWARMGLASS_CONSOLE_IP_ALLOWLIST=
# optional: mount the console on the public listener at this path (default off). prefer a separate host.
SWARMGLASS_CONSOLE_PUBLIC_MOUNT=

# ---- secrets ----
# REQUIRED in production: 32+ random bytes, hex or base64. `openssl rand -hex 32`
SWARMGLASS_SECRET_KEY=                    # TODO
# shared secret the synthetic traffic generator sends so test traffic is tagged, never confused with real
SWARMGLASS_SYNTH_TOKEN=                   # TODO (openssl rand -hex 16)

# ---- proxy / network ----
SWARMGLASS_TRUST_PROXY=true
SWARMGLASS_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12,10.0.0.0/8
# ---- privacy ----
SWARMGLASS_PRIVACY_IP_MODE=truncate_hash  # truncate | hash | truncate_hash | none
SWARMGLASS_IP_SALT_ROTATION_DAYS=1
SWARMGLASS_RETENTION_DAYS=90
SWARMGLASS_HEADER_CAPTURE=allowlist       # allowlist | names_only
SWARMGLASS_STORE_QUERY=sanitized          # sanitized | none

# ---- safety rails ----
SWARMGLASS_RATE_LIMIT_RPS=30
SWARMGLASS_RATE_LIMIT_BURST=120
SWARMGLASS_MAX_BODY_BYTES=65536
SWARMGLASS_MAX_DB_MB=2048
SWARMGLASS_MAX_LOG_MB=200
SWARMGLASS_LOG_LEVEL=info                 # debug | info | warn | error

# ---- public-facing identity (fiction lives in seed/world.json, not here) ----
SWARMGLASS_CONTACT_EMAIL=                 # TODO: shown in security.txt + humans.txt
